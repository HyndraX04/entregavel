# =========================================================
# CONFIGURAÇÕES DE AMBIENTE (.env.local ou Vercel)
# =========================================================

# 1. PERFECTPAY
# Token de segurança gerado no painel da PerfectPay (Webhook/Postback)
PERFECTPAY_SECURITY_TOKEN=seu_token_secreto_da_perfectpay_aqui

# Senha padrão atribuída aos compradores ao criar a conta automaticamente no Firebase Auth
DEFAULT_USER_PASSWORD=CANALDARK123

# 2. FIREBASE ADMIN SDK (Credenciais de Conta de Serviço)
# Obtido em: Console Firebase > Configurações do Projeto > Contas de Serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=seu-projeto-firebase-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto-firebase-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. CONFIGURAÇÕES DE ENVIO DE E-MAIL (Resend)
# Obtenha sua chave gratuita em https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Metodo Canal Dark <onboarding@resend.dev>
NEXT_PUBLIC_APP_URL=https://metodocanaldark.com.br
