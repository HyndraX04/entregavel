{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/chatfn", "destination": "/chatfn/index.html" },
    { "source": "/chatfn/(.*)", "destination": "/chatfn/$1" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/obrigado", "destination": "/obrigado.html" },
    { "source": "/membros", "destination": "/index.html" },
    { "source": "/api/webhooks/perfectpay", "destination": "/api/webhooks/perfectpay" }
  ]
}
